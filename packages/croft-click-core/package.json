{
  "name": "@ewanc26/croft-click-core",
  "version": "0.2.3",
  "description": "Shared core library for croft.click ATProto tools \u2014 publishing, rate limiting, sync, and data conversion",
  "author": "Ewan Croft",
  "license": "AGPL-3.0-only",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ewanc26/pkgs.git",
    "directory": "packages/croft-click-core"
  },
  "homepage": "https://github.com/ewanc26/pkgs/tree/main/packages/croft-click-core",
  "bugs": {
    "url": "https://github.com/ewanc26/pkgs/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./paths": {
      "types": "./dist/paths.d.ts",
      "import": "./dist/paths.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepare": "pnpm run build",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@bsky/sdk": "latest",
    "@atproto/lex": "^0.3.0",
    "@atproto/lex-password-session": "^0.2.0",
    "@ewanc26/tid": "workspace:*",
    "@ipld/car": "^5.3.2",
    "@ipld/dag-cbor": "^9.2.2",
    "multiformats": "^13.3.1"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "typescript": "^5.9.3"
  }
}
