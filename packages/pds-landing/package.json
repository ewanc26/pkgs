{
  "name": "pds-landing",
  "version": "2.1.0",
  "description": "A standalone Vite + Svelte app for an ATProto PDS landing page — terminal-aesthetic UI with live status fetching.",
  "author": "Ewan Croft",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "predev": "bun scripts/generate-metadata.js",
    "dev": "bun node_modules/vite/bin/vite.js",
    "prebuild": "bun scripts/generate-metadata.js",
    "build": "bun node_modules/vite/bin/vite.js build",
    "serve": "bun node_modules/vite/bin/vite.js preview",
    "pretypecheck": "bun scripts/generate-metadata.js",
    "typecheck": "bun node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
    "format": "bun node_modules/oxfmt/bin/oxfmt",
    "format:check": "bun node_modules/oxfmt/bin/oxfmt --check",
    "pages:build": "bun install --frozen-lockfile && bun run build",
    "deploy": "bun run build && rsync -a --delete --exclude='.well-known/' dist/ /Volumes/Storage/Server/stack/pds-landing/"
  },
  "dependencies": {
    "svelte": "^5.53.11"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^22.15.0",
    "oxfmt": "^0.57.0",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.5.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "svelte-check": "^4.4.5",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.0"
  }
}
