{
  "name": "@ewanc26/rock-tumbl-web",
  "version": "0.1.0",
  "description": "Web frontend for rock-tumbl — convert Tumblr blog exports into Standard.site documents",
  "author": "Ewan Croft",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "keywords": [
    "tumblr",
    "standard.site",
    "atproto",
    "converter",
    "svelte",
    "sveltekit"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ewanc26/pkgs.git",
    "directory": "packages/rock-tumbl-web"
  },
  "homepage": "https://github.com/ewanc26/pkgs/tree/main/packages/rock-tumbl-web",
  "bugs": {
    "url": "https://github.com/ewanc26/pkgs/issues"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@atproto/lex": "^0.3.0",
    "@atproto/lex-password-session": "^0.2.0",
    "@bsky/sdk": "latest",
    "@ewanc26/landing-ui": "workspace:*",
    "@ewanc26/rock-tumbl": "workspace:*",
    "@lucide/svelte": "^0.575.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-vercel": "^6.3.1",
    "@sveltejs/kit": "^2.50.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.1.18",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.4.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "svelte": "^5.51.0",
    "svelte-check": "^4.3.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vercel": "^50.44.0",
    "vite": "^7.3.1"
  }
}