{
  "name": "@ewanc26/malachite-web",
  "version": "0.11.1",
  "description": "Web frontend for Malachite — import your music listening history to AT Protocol",
  "author": "Ewan Croft",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "keywords": [
    "lastfm",
    "atproto",
    "bluesky",
    "svelte",
    "sveltekit"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ewanc26/pkgs.git",
    "directory": "packages/malachite-web"
  },
  "homepage": "https://github.com/ewanc26/pkgs/tree/main/packages/malachite-web",
  "bugs": {
    "url": "https://github.com/ewanc26/pkgs/issues"
  },
  "scripts": {
    "dev": "vite dev",
    "prebuild": "pnpm --filter @ewanc26/tid build && pnpm --filter @ewanc26/croft-click-core build && pnpm --filter @ewanc26/malachite... build",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@atproto/common-web": "^0.4.12",
    "@atproto/lex": "^0.3.0",
    "@atproto/lex-password-session": "^0.2.0",
    "@atproto/oauth-client-browser": "^0.3.41",
    "@bsky/sdk": "latest",
    "@ewanc26/croft-click-core": "workspace:*",
    "@ewanc26/landing-ui": "workspace:*",
    "@lucide/svelte": "^0.575.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-vercel": "^7.0.5",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4.1.18",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.4.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "svelte": "^5.57.1",
    "svelte-check": "^4.3.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^6.0.2",
    "vercel": "^54.17.1",
    "vite": "^8.1.6"
  }
}
